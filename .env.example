# Local credentials. Ignored by Git; never paste these values into chat.
# Keep each value on one line. Empty keys disable that provider.

# Azure Translator, single-service F0
# Leave REGION empty for Global. The resource-group region is separate.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_API_VERSION=2026-06-06

# DeepL, endpoint verified before translation
DEEPL_API_KEY=
DEEPL_API_ENDPOINT=https://api-free.deepl.com

# Cohere, translation LLM
COHERE_API_KEY=
COHERE_API_ENDPOINT=https://api.cohere.com
COHERE_TRANSLATION_MODEL=north-small-translate-09-2026
COHERE_FAST_MODEL=command-r7b-12-2024

# Google Cloud Translation Basic v2, optional
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_ENDPOINT=https://translation.googleapis.com

