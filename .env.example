# Local credentials. Ignored by Git; never paste these values into chat.
# Keep each value on one line. Empty keys disable that provider.

# Azure Translator, single-service F0
# Leave REGION empty for Global. The resource-group region is separate.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_API_VERSION=2026-06-06

# DeepL, endpoint verified before translation
DEEPL_API_KEY=
DEEPL_API_ENDPOINT=https://api-free.deepl.com

# Cohere, translation LLM
COHERE_API_KEY=
COHERE_API_ENDPOINT=https://api.cohere.com
COHERE_TRANSLATION_MODEL=north-small-translate-09-2026
COHERE_FAST_MODEL=command-r7b-12-2024

# Google Cloud Translation Basic v2, optional
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_ENDPOINT=https://translation.googleapis.com

# Groq Free plan, translation LLM with thinking disabled
GROQ_API_KEY=
GROQ_API_ENDPOINT=https://api.groq.com
GROQ_TRANSLATION_MODEL=qwen/qwen3.8-27b
GROQ_MAX_OUTPUT_TOKENS=1000

# Cloudflare Workers AI, traditional translation model
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_ENDPOINT=https://api.cloudflare.com
CLOUDFLARE_TRANSLATION_MODEL=@cf/meta/m2m100-1.2b

# Gemini through AI Studio Free Tier; separate from Google Cloud Translation
GEMINI_API_KEY=
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com
GEMINI_TRANSLATION_MODEL=gemini-3.1-flash-lite

# Cerebras, optional promotional trial
CEREBRAS_API_KEY=
CEREBRAS_API_ENDPOINT=https://api.cerebras.ai
CEREBRAS_TRANSLATION_MODEL=qwen-3.8-27b

# Optional OpenCode Go experiment, scripts/benchmark-opencode-go.py.
# --auth-file can use the existing local credential without copying it here.
OPENCODE_GO_API_KEY=
