{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "curly": ["error", "all"],
    "one-var": ["error", "never"],
    "no-multi-assign": "error",
    "no-nested-ternary": "error"
  },
  "env": {
    "browser": true
  },
  "overrides": [
    {
      "files": ["scripts/**/*.ts", "src/**/*.test.ts"],
      "env": {
        "node": true
      },
      "globals": {
        "Bun": "readonly"
      }
    }
  ]
}
