{
  "name": "shvyd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:local": "bun scripts/build.ts --local",
    "package": "bun scripts/package.ts",
    "dev": "bun scripts/dev.ts",
    "playground": "bun scripts/dev.ts",
    "test": "bun test src scripts/build.test.ts scripts/package.test.ts",
    "test:reliability": "bun run build && python3 scripts/check-reliability.py",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src scripts demo",
    "lint:fix": "oxlint --fix --deny-warnings src scripts demo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build",
    "check": "bun run verify",
    "fix": "pnpm lint:fix && pnpm format && pnpm verify",
    "languages:update": "bun scripts/update-languages.ts",
    "worker:deploy": "bun scripts/deploy-worker.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/chrome": "^0.3.4",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
